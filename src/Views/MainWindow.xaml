 <Window x:Class="tiny11_ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:tiny11_ui.ViewModels"
        mc:Ignorable="d"
        Title="Tiny11 GUI" Height="700" Width="900" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Üst kısımda dil seçici -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Label Content="🌐" VerticalAlignment="Center" FontSize="16" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Width="120" VerticalAlignment="Center" 
                      ToolTip="{Binding LocalizedTooltips.LanguageSelector}"/>
        </StackPanel>

        <Label Content="{Binding LocalizedLabels.IsoSelection}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Text="{Binding IsoPath}" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" IsReadOnly="True"/>
        <Button Command="{Binding BrowseIsoCommand}" Content="{Binding LocalizedButtons.BrowseButton}" Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" Padding="15,5"/>
        <Label Content="{Binding LocalizedLabels.WorkingDirectory}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,10,0"/>
        <TextBox Text="{Binding ScratchPath}" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,10,0,0"/>
        <Button Command="{Binding BrowseScratchCommand}" Content="{Binding LocalizedButtons.SelectButton}" Grid.Row="2" Grid.Column="2" Margin="10,10,0,0" Padding="15,5"/>
        
        <Label Content="{Binding LocalizedLabels.OutputPath}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,10,0"/>
        <TextBox Text="{Binding OutputPath}" Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,10,0,0"/>
        <Button Command="{Binding BrowseOutputCommand}" Content="{Binding LocalizedButtons.SaveButton}" Grid.Row="3" Grid.Column="2" Margin="10,10,0,0" Padding="15,5"/>
        
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0">
            <Label Content="{Binding LocalizedLabels.ImageType}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton Content="{Binding LocalizedLabels.StandardType}" IsChecked="{Binding IsStandardBuild}" GroupName="ImageType" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <RadioButton Content="{Binding LocalizedLabels.CoreType}" IsChecked="{Binding IsCoreBuild}" GroupName="ImageType" VerticalAlignment="Center"/>
        </StackPanel>
        <Label Content="{Binding LocalizedLabels.WindowsEdition}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,10,0"/>
        <ComboBox ItemsSource="{Binding WindowsEditions}" SelectedItem="{Binding SelectedEdition}" IsEnabled="{Binding IsEditionSelectionEnabled}" Grid.Row="5" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,10,0,0"/>
        
        <Expander Header="{Binding LocalizedHeaders.AdvancedOptions}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0" IsExpanded="False">
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" Margin="0,5,0,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="{Binding LocalizedHeaders.PresetSelection}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <RadioButton Content="{Binding LocalizedPresets.Minimal}" IsChecked="{Binding IsMinimalPreset}" GroupName="Preset" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.MinimalPreset}"/>
                            <RadioButton Content="{Binding LocalizedPresets.Balanced}" IsChecked="{Binding IsBalancedPreset}" GroupName="Preset" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.BalancedPreset}"/>
                            <RadioButton Content="{Binding LocalizedPresets.Gaming}" IsChecked="{Binding IsGamingPreset}" GroupName="Preset" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.GamingPreset}"/>
                            <RadioButton Content="{Binding LocalizedPresets.Enterprise}" IsChecked="{Binding IsEnterprisePreset}" GroupName="Preset" ToolTip="{Binding LocalizedTooltips.EnterprisePreset}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding LocalizedHeaders.AppsToRemove}" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <StackPanel Margin="5">
                            <CheckBox IsChecked="{Binding RemoveEdge}" Content="{Binding LocalizedApps.MicrosoftEdge}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding RemoveOneDrive}" Content="{Binding LocalizedApps.OneDrive}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding RemoveCortana}" Content="{Binding LocalizedApps.Cortana}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding RemoveChat}" Content="{Binding LocalizedApps.WindowsChat}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding RemoveTeams}" Content="{Binding LocalizedApps.MicrosoftTeams}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding RemoveXbox}" Content="{Binding LocalizedApps.XboxApps}" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding LocalizedHeaders.SystemFeaturesToDisable}" Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                        <StackPanel Margin="5">
                            <CheckBox IsChecked="{Binding DisableTelemetry}" Content="{Binding LocalizedSystemFeatures.Telemetry}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding DisableWindowsUpdate}" Content="{Binding LocalizedSystemFeatures.WindowsUpdate}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding DisableDefender}" Content="{Binding LocalizedSystemFeatures.WindowsDefender}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding DisableSponsoredApps}" Content="{Binding LocalizedSystemFeatures.SponsoredApps}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding DisableReservedStorage}" Content="{Binding LocalizedSystemFeatures.ReservedStorage}" Margin="0,2"/>
                            <CheckBox IsChecked="{Binding DisableBitLocker}" Content="{Binding LocalizedSystemFeatures.BitLocker}" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding LocalizedHeaders.SystemRequirementsBypass}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <CheckBox IsChecked="{Binding BypassTPM}" Content="{Binding LocalizedSystemRequirements.TPMRequirement}" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.TPMBypass}"/>
                            <CheckBox IsChecked="{Binding BypassCPU}" Content="{Binding LocalizedSystemRequirements.CPUCompatibility}" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.CPUBypass}"/>
                            <CheckBox IsChecked="{Binding BypassRAM}" Content="{Binding LocalizedSystemRequirements.RAMRequirement}" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.RAMBypass}"/>
                            <CheckBox IsChecked="{Binding BypassSecureBoot}" Content="{Binding LocalizedSystemRequirements.SecureBootRequirement}" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.SecureBootBypass}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding LocalizedHeaders.InstallationProcessBypass}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <CheckBox IsChecked="{Binding BypassMSAccount}" Content="{Binding LocalizedInstallationProcess.MicrosoftAccountRequirement}" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.MSAccountBypass}"/>
                            <CheckBox IsChecked="{Binding SkipNetworkConnection}" Content="{Binding LocalizedInstallationProcess.NetworkConnectionCheck}" Margin="0,0,15,0" ToolTip="{Binding LocalizedTooltips.NetworkBypass}"/>
                            <CheckBox IsChecked="{Binding SkipPrivacyQuestions}" Content="{Binding LocalizedInstallationProcess.PrivacySettings}" ToolTip="{Binding LocalizedTooltips.PrivacyBypass}"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Border>
        </Expander>
        
        <Button Command="{Binding StartBuildCommand}" Content="{Binding LocalizedButtons.StartBuildButton}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Padding="0,10" FontWeight="Bold" Background="#0078D4" Foreground="White" Margin="0,15,0,0"/>
        <TextBox Text="{Binding LogOutput, Mode=OneWay}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap"/>
        <StatusBar Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
